# Central Configuration File for Kubernetes Lab (v3)

# Repo and Local Working Directory
REPO_PATH="/home/ubuntu/k8slabs/kuberneteslab/v3"

# Credentials & SSH Config
SSH_USER="ubuntu"
# Leave empty to use SSH key-based auth. If password is set, 'sshpass' will be used.
SSH_PASS=""

# Cluster & Networking Settings
K8S_VERSION="v1.31"
POD_CIDR="10.244.0.0/16"

# Control Node Configuration
CONTROL_NAME="control"
CONTROL_IP="192.168.178.51"

# Worker Nodes Configuration (Arrays must match in index order)
WORKER_NAMES=("worker01" "worker03")
WORKER_IPS=("192.168.178.52" "192.168.178.53")
